<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:NtfsStreamsViewer.ViewModels"
        xmlns:services="using:NtfsStreamsViewer.Services"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="NtfsStreamsViewer.Views.LogWindow"
        x:DataType="vm:LogWindowViewModel"
        Title="Application log"
        Width="900" Height="600"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="8">

    <!-- ===== Toolbar ===== -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Content="Clear" Command="{Binding ClearUiCommand}"/>
      <Button Content="Copy all" Command="{Binding CopyAllCommand}"/>
      <Button Content="Save…" Command="{Binding SaveCommand}"/>
      <Button Content="Open log file" Command="{Binding OpenLogFileCommand}"/>
      <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center"/>
      <TextBlock Text="Level:" VerticalAlignment="Center" Margin="12,0,4,0"/>
      <ComboBox ItemsSource="{x:Static services:AppLogger.Levels}"
                SelectedItem="{Binding MinimumLevel}" MinWidth="90" VerticalAlignment="Center"/>
      <TextBox Watermark="Filter…" Text="{Binding FilterText}" Width="180" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- ===== Path / counters bar ===== -->
    <Border DockPanel.Dock="Bottom" Padding="6,4" Margin="0,8,0,0"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
            CornerRadius="4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding LogFilePath}"
                   TextTrimming="CharacterEllipsis" Opacity="0.75" FontSize="11"
                   ToolTip.Tip="Rotating log file on disk"/>
        <TextBlock Grid.Column="1" FontSize="11" Opacity="0.75">
          <Run Text="Errors: "/><Run Text="{Binding ErrorCount}"/>
        </TextBlock>
      </Grid>
    </Border>

    <!-- ===== Tabs: live log | scan errors ===== -->
    <TabControl>
      <TabItem Header="Live log">
        <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto">
          <ItemsControl x:Name="LogList" ItemsSource="{Binding Entries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="services:LogEntry">
                <TextBlock FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12"
                           TextWrapping="NoWrap" Margin="0,1">
                  <Run Text="{Binding TimeText}"/><Run Text=" ["/><Run Text="{Binding Level}"/><Run Text="] "/><Run Text="{Binding Category}"/><Run Text=": "/><Run Text="{Binding Message}"/>
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Scan errors">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Margin="4,4,4,8"
                     Text="Per-path error details collected during the current/last scan (scan.error notifications + completion payload)."/>
          <ListBox ItemsSource="{Binding Errors}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ScanErrorRow">
                <StackPanel Spacing="2" Margin="2">
                  <TextBlock FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12">
                    <Run Text="#"/><Run Text="{Binding Index}"/><Run Text="  "/><Run Text="{Binding Path}"/>
                  </TextBlock>
                  <TextBlock Opacity="0.8" FontSize="12" TextWrapping="Wrap"
                             Text="{Binding Message}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
